<mxfile host="app.diagrams.net" agent="Codex" version="29.0.3">
  <!-- 依据 ReAct、ToRA 和 ToRL 的通用工具交互机制绘制；蓝、红、橙分别沿用 PTCS-RL 图中的 #8BA5C5、#E18C88、#EEB274。 -->
  <diagram id="tool-augmented-reasoning" name="图2.1 工具增强数学推理交互流程">
    <mxGraphModel dx="1370" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="790" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="input" value="&lt;b&gt;数学题目与当前上下文&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;题目条件 · 已有推理 · 历史工具反馈&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F5F6F7;strokeColor=#777777;strokeWidth=2;fontFamily=SimSun;fontSize=21;fontColor=#26323C;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="170" y="35" width="840" height="95" as="geometry" />
        </mxCell>

        <mxCell id="model-panel" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#8BA5C5;strokeWidth=2.4;" vertex="1" parent="1">
          <mxGeometry x="60" y="185" width="530" height="390" as="geometry" />
        </mxCell>
        <mxCell id="model-header" value="&lt;b&gt;语言模型&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;负责推理、决策和结果整合&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8BA5C5;strokeColor=#8BA5C5;strokeWidth=2;fontFamily=SimSun;fontSize=21;fontColor=#182B41;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="185" width="530" height="70" as="geometry" />
        </mxCell>
        <mxCell id="model-step-1" value="1  题意理解与推理规划" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8BA5C5;strokeWidth=1.8;fontFamily=SimSun;fontSize=18;fontColor=#26323C;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="130" y="278" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="model-step-2" value="2  自然语言推理与工具调用决策" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8BA5C5;strokeWidth=1.8;fontFamily=SimSun;fontSize=18;fontColor=#26323C;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="130" y="372" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="model-step-3" value="3  结合反馈验证、修正或结束" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8BA5C5;strokeWidth=1.8;fontFamily=SimSun;fontSize=18;fontColor=#26323C;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="130" y="466" width="400" height="64" as="geometry" />
        </mxCell>

        <mxCell id="tool-panel" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF8F7;strokeColor=#E18C88;strokeWidth=2.4;" vertex="1" parent="1">
          <mxGeometry x="660" y="185" width="460" height="390" as="geometry" />
        </mxCell>
        <mxCell id="tool-header" value="&lt;b&gt;外部工具执行环境&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;负责执行，不决定求解策略&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E18C88;strokeColor=#E18C88;strokeWidth=2;fontFamily=SimSun;fontSize=21;fontColor=#4A2020;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="660" y="185" width="460" height="70" as="geometry" />
